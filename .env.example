# Copier en .env puis adapter
# IP LAN de la machine Docker : psacc n'écoute que sur cette interface
LAN_IP=192.168.1.51
PSACC_VERSION=v3.7.10

# Google Sheet cible (la clé du compte de service va dans secrets/google-sa.json)
SPREADSHEET_ID=<id du Google Sheet>
# VIN de l'e-208 ; vide = premier véhicule électrique de psacc/config/cars.json
VIN=
# Intervalle entre deux synchros (secondes)
SYNC_INTERVAL=3600
# true = calcule et journalise sans écrire dans le Sheet
DRY_RUN=false
# Heures (Paris) de réveil de la voiture, seulement si une charge est en cours ; vide = jamais
WAKEUP_AT=03:00,05:55

# Front web (miroir en lecture seule du Sheet), publié sur LAN_IP uniquement
DASHBOARD_PORT=8080
# Durée du cache des données du Sheet (secondes)
DASHBOARD_CACHE_SECONDS=300
# Comparatif des offres (prix TTC du kWh ; une offre sans prix est signalée « à renseigner »)
BASE_PRICE_KWH=0.1985
# Option Heures creuses (mêmes heures creuses que Tempo, onglet Paramètres)
HCHP_HC_PRICE_KWH=0.1589
HCHP_HP_PRICE_KWH=0.2142
# Option Zen Week-End + HC : prix bas (week-end, jours fériés, HC en semaine) / prix haut (HP en semaine)
ZEN_LOW_PRICE_KWH=0.1692
ZEN_HIGH_PRICE_KWH=0.2260
# Équivalent essence : consommation de la voiture thermique de référence (L/100 km), carburant
# (sp98, e10, sp95, gazole…) et département (vide = moyenne nationale) ; prix moyen relu chaque semaine
PETROL_L_100KM=7
PETROL_FUEL=sp98
PETROL_DEPARTEMENT=
# Capacité utile de la batterie (kWh) : % de la batterie affiché après les kWh du tableau des recharges
BATTERY_KWH=46

# Mire de connexion pour l'accès distant (voir README) ; jamais dans git
# Empreinte du mot de passe : docker compose run --rm e208-dashboard --hash-password (vide = pas de mire)
DASHBOARD_PASSWORD_HASH=
# Clé TOTP (code d'application d'authentification après le mot de passe) : --setup-totp ; vide = mot de passe seul
DASHBOARD_TOTP_SECRET=
# Clé de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# IP LAN du reverse proxy Synology : seules ses requêtes portent l'IP réelle du visiteur (X-Real-IP)
TRUSTED_PROXY=
# proxy = mot de passe pour les accès via le Synology, accès LAN direct libre ; all = partout
LOGIN_SCOPE=proxy
