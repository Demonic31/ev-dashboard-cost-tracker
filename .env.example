# Copier en .env puis adapter
# Marque : dossier de brands/ (services et source de données) ; stellantis = Peugeot, Citroën, DS, Opel via psacc
BRAND=stellantis
# IP LAN de la machine Docker : les services n'écoutent que sur cette interface
LAN_IP=192.168.1.10
# Google Sheet cible (la clé du compte de service va dans secrets/google-sa.json)
SPREADSHEET_ID=<id du Google Sheet>

# --- Stellantis : psacc et synchro du Sheet (brands/stellantis/README.md)
PSACC_VERSION=v3.7.10
# VIN du véhicule ; vide = premier véhicule électrique de psacc/config/cars.json
VIN=
# Intervalle entre deux synchros (secondes)
SYNC_INTERVAL=3600
# true = calcule et journalise sans écrire dans le Sheet
DRY_RUN=false
# Heures (Paris) de réveil de la voiture, seulement si une charge est en cours ; vide = jamais
WAKEUP_AT=03:00,05:55

# Front web (miroir en lecture seule du Sheet), publié sur LAN_IP uniquement
DASHBOARD_PORT=8080
# Durée du cache des données du Sheet (secondes)
DASHBOARD_CACHE_SECONDS=300
# Comparatif des offres (prix TTC du kWh ; une offre sans prix est signalée « à renseigner »)
BASE_PRICE_KWH=0.1985
# Option Heures creuses (mêmes heures creuses que Tempo, onglet Paramètres)
HCHP_HC_PRICE_KWH=0.1589
HCHP_HP_PRICE_KWH=0.2142
# Option Zen Week-End + HC : prix bas (week-end, jours fériés, HC en semaine) / prix haut (HP en semaine)
ZEN_LOW_PRICE_KWH=0.1692
ZEN_HIGH_PRICE_KWH=0.2260
# Équivalent carburant : voiture(s) thermique(s) de référence, « carburant:consommation (L/100 km) » séparés
# par des virgules (sp98, sp95, e10, e85, gazole, gplc ; décimale avec un point), ex. sp98:7,gazole:5.5 ;
# département pour le prix moyen (vide = moyenne nationale) ; prix relus chaque jour
PETROL_FUELS=sp98:7
PETROL_DEPARTEMENT=
# Anciens réglages, encore lus : PETROL_FUEL (carburant unique, si PETROL_FUELS est vide) et PETROL_L_100KM
# (consommation par défaut d'un carburant écrit sans « : »)
#PETROL_FUEL=sp98
#PETROL_L_100KM=7
# Capacité utile de la batterie (kWh) : % de la batterie affiché après les kWh du tableau des recharges
BATTERY_KWH=46
# Titre de l'en-tête « Marque Modèle » ; vide = lu sur la source de la marque (ex. « Peugeot e-208 »)
VEHICLE_NAME=
# Logo personnel de l'en-tête : nom d'un fichier .svg ou .png déposé dans local/ (non versionné, voir local/README.md) ;
# vide = icône de l'application. DASHBOARD_LOGO_INVERT=1 inverse un logo noir en thème sombre.
DASHBOARD_LOGO=
DASHBOARD_LOGO_INVERT=

# Mire de connexion pour l'accès distant (voir README) ; jamais dans git
# Empreinte du mot de passe : docker compose run --rm ev-dashboard --hash-password (vide = pas de mire)
DASHBOARD_PASSWORD_HASH=
# Clé TOTP (code d'application d'authentification après le mot de passe) : --setup-totp ; vide = mot de passe seul
DASHBOARD_TOTP_SECRET=
# Clé de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# Reverse proxy : IP LAN (Synology…) ou « caddy » avec le proxy intégré (profil proxy) ; seules ses requêtes
# portent l'IP réelle du visiteur (X-Real-IP)
TRUSTED_PROXY=
# proxy = mot de passe pour les accès via le Synology, accès LAN direct libre ; all = partout
LOGIN_SCOPE=proxy

# Reverse proxy intégré (Caddy, HTTPS Let's Encrypt automatique) : docker compose --profile proxy up -d
# Nom de domaine public du dashboard (DNS vers l'IP publique, ports 80 et 443 redirigés vers ce serveur)
DASHBOARD_DOMAIN=
# CADDY_VERSION=2.8.4-alpine
