# Copier en preprod/.env (chmod 600), jamais dans git.
LAN_IP=192.168.1.10
PREPROD_PORT=8081

# Pile principale : réglages du dashboard, base psacc (lecture seule), réseau Docker et clé Google
MAIN_ENV_FILE=/home/thomas/208-cost-tracker/.env
PSACC_CONFIG_DIR=/home/thomas/208-cost-tracker/psacc/config
PSACC_NETWORK=208-cost-tracker_default
GOOGLE_SA_FILE=/home/thomas/208-cost-tracker/secrets/google-sa.json
# Dossier local/ de la pile principale (logo personnel) ; par défaut celui du dépôt de la PREPROD
# LOCAL_DIR=/home/thomas/208-cost-tracker/local

# Mire de connexion : empreinte du mot de passe, générée par
#   docker compose --env-file preprod/.env -f preprod/docker-compose.yml run --rm ev-dashboard --hash-password
# (vide = pas de mire). Changer le mot de passe déconnecte toutes les sessions.
DASHBOARD_PASSWORD_HASH=
# Code TOTP (application d'authentification) demandé après le mot de passe ; vide = mot de passe seul. Générée par
#   docker compose --env-file preprod/.env -f preprod/docker-compose.yml run --rm -T ev-dashboard --setup-totp
# Changer la clé déconnecte toutes les sessions et invalide l'ancienne inscription dans l'application.
DASHBOARD_TOTP_SECRET=
# Clé de signature des sessions : openssl rand -hex 32
SESSION_SECRET=
# IP LAN du reverse proxy Synology : seules ses requêtes portent l'IP réelle du visiteur (X-Real-IP)
TRUSTED_PROXY=
# proxy = mot de passe demandé pour les accès via le Synology, accès LAN direct libre ; all = partout.
# Tant que TRUSTED_PROXY est vide, le mot de passe est demandé partout.
LOGIN_SCOPE=proxy

# Page « PREPROD en pause » (preprod/preprod.sh off) : bouton vers le dashboard de PROD ; vide = pas de bouton
PAUSE_LINK=
